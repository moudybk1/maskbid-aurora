# ---- shared (local defaults work with `npm run anvil` + `npm run deploy:local`) ----
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# ---- apps/solver: local adapter + keeper + solver (NOT a TEE; see README) ----
# Must equal the deployment's callbackSender. Anvil account #9 by default.
CALLBACK_SENDER_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6
KEYSTORE_DIR=./keystore
EVIDENCE_DIR=./evidence
POLL_MS=3000

# ---- apps/web ----
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
APP_ORIGIN=http://localhost:3000
# Server-only. Enables the labelled simulator at /verify. Anvil account #0 (registrar) by default.
IDENTITY_SIMULATOR=true
IDENTITY_REGISTRAR_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
IDENTITY_HMAC_SECRET=local-dev-only-change-me
# Where the solver writes execution evidence (read by /api/evidence)
SOLVER_EVIDENCE_DIR=../solver/evidence

# ---- apps/keeper: Aurora testnet keeper for the private path (needs contracts/deployments/1313161555.json) ----
# CHAIN_ID=1313161555
# RPC_URL=https://testnet.aurora.dev
# KEEPER_KEY=0x...                      # any funded Aurora EOA; it only calls permissionless timers
# NEAR_ADAPTER_ACCOUNT=maskbid-adapter.testnet
# NEAR_KEEPER_ACCOUNT=maskbid-keeper.testnet   # operator of the adapter; key in ~/.near-credentials (near-cli-rs legacy keychain)
